# NebenkostenCheck - Environment Variables
# ==========================================
# WICHTIG: Diese Datei NICHT committen! Sie ist in .gitignore.
# Erstelle eine Kopie als .env.local und trage die echten Werte ein.
#
# Wo findest du diese Werte?
# -> Supabase Dashboard: https://supabase.com/dashboard
# -> Project Settings -> API
# ==========================================

# -------------------------------------------------------
# SUPABASE (Pflicht)
# -------------------------------------------------------

# Project URL (z.B. https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT-ID.supabase.co

# Anon/Public Key (sicher fuer Browser, unterliegt Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (NUR fuer Server-Seite, NIEMALS im Browser verwenden!)
# -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -------------------------------------------------------
# STRIPE (Optional fuer Tag 1 - wird in Phase 6 benoetigt)
# -------------------------------------------------------

# Stripe Secret Key (Server-only, Stripe Dashboard -> Developers -> API keys)
# STRIPE_SECRET_KEY=sk_test_...

# Stripe Publishable Key (fuer Browser)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook Secret (Stripe Dashboard -> Webhooks)
# STRIPE_WEBHOOK_SECRET=whsec_...

# -------------------------------------------------------
# APP-KONFIGURATION
# -------------------------------------------------------

# Oeffentliche App-URL (ohne abschliessenden Slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
